---
import { BOOK_HREF } from "../consts";
import Icon from "./Icon.astro";

const steps = [
  {
    title: "Book a free consultation",
    text: "Pick a time that works for you. Takes 30 seconds.",
  },
  {
    title: "30-min Google Meet with our specialist",
    text: "We’ll learn about your nonprofit, discuss the challenges you’re having with your Google Ad Grant, understand what you want to improve, and explain how our team can help",
  },
];
---

<section id="how-it-works" class="section" aria-labelledby="hiw-title">
  <div class="container-page grid gap-6 lg:grid-cols-[1fr_1fr] lg:gap-14">
    <div class="text-center lg:text-left">
      <p class="eyebrow reveal">What to expect</p>
      <h2 id="hiw-title" class="h2 reveal mt-5">How it works</h2>
      <p class="lead reveal mx-auto mt-4 max-w-[600px] lg:mx-0 xl:mt-6">
        Your active time: 30 minutes. We handle the rest. No prep needed. No
        technical knowledge required. Just show up.
      </p>
    </div>

    <div>
      <ol class="reveal-stagger">
        {
          steps.map((s, i) => (
            <li class="grid grid-cols-[56px_1fr] gap-x-[18px] lg:grid-cols-[48px_1fr] lg:gap-x-[27px]">
              <div class="flex flex-col items-center">
                <span class="grid size-14 place-items-center rounded-full bg-lime text-[18px] font-medium text-olive lg:size-12">
                  {i + 1}
                </span>
                {i < steps.length - 1 && (
                  <span class="my-4 w-px flex-1 bg-olive" aria-hidden="true" />
                )}
              </div>
              <div class:list={[i < steps.length - 1 && "pb-[70px] lg:pb-[100px]"]}>
                <h3 class="pt-3 text-[20px] font-medium leading-[1.3] text-ink lg:pt-2 xl:text-[24px]">
                  {s.title}
                </h3>
                <p class="mt-3 text-[16px] leading-normal text-body xl:text-[18px]">
                  {s.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <a
        href={BOOK_HREF}
        class="btn btn-primary btn-lg mt-12 w-full sm:w-auto lg:ml-[75px] lg:mt-6 xl:min-w-[262px]"
      >
        Book a call
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>
