---
import { BOOK_HREF } from "../consts";
import Icon from "./Icon.astro";

const problems = [
  {
    icon: "wallet",
    title: "Most of your grant goes unused",
    text: "You have $10,000/month in free Google Ads, but your campaigns spend only a fraction of it.",
  },
  {
    icon: "bars",
    title: "Your website barely gets visitors",
    text: "Your campaigns are running, but hardly anyone clicks through to your website.",
  },
  {
    icon: "file-target",
    title: "Reaching the wrong people",
    text: "You're getting clicks, but visitors aren't signing up, donating, or taking action.",
  },
  {
    icon: "refresh",
    title: "You’ve tried everything",
    text: "You've followed Google's guides, adjusted your campaigns, and still aren't seeing better results.",
  },
  {
    icon: "gear",
    title: "Don’t know what to fix",
    text: "Your account has dozens of settings, and it's hard to tell what needs fixing.",
  },
  {
    icon: "question",
    title: "You've hired help, but nothing improved",
    text: "You paid for help, received reports every month, but the numbers never really improved",
  },
] as const;
---

<section class="section" aria-labelledby="problem-title">
  <div class="container-page">
    <div class="text-center">
      <p class="eyebrow reveal">The problem</p>
      <h2 id="problem-title" class="h2 reveal mx-auto mt-5 max-w-[900px]">
        You have the Google Ad Grant, <br class="hidden xl:inline" />but you’re
        not seeing results
      </h2>
    </div>

    <ul
      class="reveal-stagger mt-8 grid gap-4 md:grid-cols-2 xl:mt-16 xl:grid-cols-3 xl:gap-[25px]"
    >
      {
        problems.map((p) => (
          <li class="card-cream rounded-[24px] p-5 xl:min-h-[273px] xl:rounded-[40px] xl:p-[37px] xl:pt-[33px]">
            <span class="grid size-10 place-items-center rounded-[12px] border border-blush-line bg-blush text-wine">
              <Icon name={p.icon} size={26} />
            </span>
            <h3 class="mt-6 text-[20px] font-medium leading-[1.3] text-ink xl:mt-4 xl:text-[24px]">
              {p.title}
            </h3>
            <p class="mt-3 text-[17px] leading-[1.53] text-body xl:mt-2.5">
              {p.text}
            </p>
          </li>
        ))
      }
    </ul>

    <div
      class="dark-panel reveal mt-4 flex flex-col gap-6 rounded-[24px] p-5 xl:mt-[25px] xl:min-h-[232px] xl:flex-row xl:items-center xl:justify-between xl:gap-10 xl:rounded-[40px] xl:px-16"
    >
      <p
        class="max-w-[660px] text-[17px] font-medium leading-[1.53] xl:text-[20px] xl:leading-[1.5]"
      >
        If you recognise yourself here — you're not alone. Based on our data, <span
          class="text-lime"
          >8 out of 10 Google Ad Grants run at 10–20% of their potential.</span
        > And in almost every case, the problem isn't the Google Ad Grant itself —
        it's how the account is set up.
      </p>
      <a href={BOOK_HREF} class="btn btn-primary btn-lg shrink-0 xl:min-w-[420px]">
        Book a free consultation
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>
